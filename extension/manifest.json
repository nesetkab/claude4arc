{
  "manifest_version": 3,
  "name": "Arc for Claude",
  "version": "0.3.0",
  "description": "Lets Claude Code control Arc through a local native messaging bridge.",
  "key": "",
  "permissions": [
    "alarms",
    "debugger",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "125",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
